<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_route_delivery" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.route_delivery</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Reparto" name="route_delivery_settings">
                    <setting string="Validar el traslado al entregar"
                             help="La app valida el traslado con lo entregado. Dejalo apagado si se valida al salir del depósito.">
                        <field name="route_delivery_validate_on_delivery"/>
                    </setting>
                    <setting string="Avisar al cliente por correo"
                             help="En camino, sos el próximo, entregado y no entregado, con el link de seguimiento.">
                        <field name="route_delivery_notify_email"/>
                    </setting>
                    <setting string="Avisar al cliente por WhatsApp"
                             help="Avisos automáticos por WhatsApp Business. Necesita plantillas aprobadas por Meta con tres variables: {{1}} nombre, {{2}} pedido, {{3}} link de seguimiento.">
                        <field name="route_delivery_whatsapp_enabled"/>
                        <div class="content-group" invisible="not route_delivery_whatsapp_enabled">
                            <div class="row mt8">
                                <label for="route_delivery_whatsapp_phone_id" class="col-lg-5"/>
                                <field name="route_delivery_whatsapp_phone_id" class="col-lg-7"/>
                            </div>
                            <div class="row">
                                <label for="route_delivery_whatsapp_token" class="col-lg-5"/>
                                <field name="route_delivery_whatsapp_token" class="col-lg-7" password="True"/>
                            </div>
                            <div class="row">
                                <label for="route_delivery_whatsapp_language" class="col-lg-5"/>
                                <field name="route_delivery_whatsapp_language" class="col-lg-3"/>
                            </div>
                            <div class="row">
                                <label for="route_delivery_whatsapp_country_code" class="col-lg-5"/>
                                <field name="route_delivery_whatsapp_country_code" class="col-lg-3" placeholder="54"/>
                            </div>
                            <div class="row">
                                <label for="route_delivery_whatsapp_tpl_on_the_way" class="col-lg-5"/>
                                <field name="route_delivery_whatsapp_tpl_on_the_way" class="col-lg-7"/>
                            </div>
                            <div class="row">
                                <label for="route_delivery_whatsapp_tpl_next" class="col-lg-5"/>
                                <field name="route_delivery_whatsapp_tpl_next" class="col-lg-7"/>
                            </div>
                            <div class="row">
                                <label for="route_delivery_whatsapp_tpl_delivered" class="col-lg-5"/>
                                <field name="route_delivery_whatsapp_tpl_delivered" class="col-lg-7"/>
                            </div>
                            <div class="row">
                                <label for="route_delivery_whatsapp_tpl_failed" class="col-lg-5"/>
                                <field name="route_delivery_whatsapp_tpl_failed" class="col-lg-7"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Avisar al cliente por SMS"
                             help="Para clientes sin WhatsApp o como respaldo. En los textos podés usar {empresa}, {nombre}, {pedido} y {link}. Sin acentos entran 160 caracteres por SMS; con acentos, 70.">
                        <field name="route_delivery_sms_enabled"/>
                        <div class="content-group" invisible="not route_delivery_sms_enabled">
                            <div class="row mt8">
                                <label for="route_delivery_sms_provider" class="col-lg-5"/>
                                <field name="route_delivery_sms_provider" class="col-lg-7"/>
                            </div>
                            <div class="row">
                                <label for="route_delivery_sms_mode" class="col-lg-5"/>
                                <field name="route_delivery_sms_mode" class="col-lg-7"/>
                            </div>
                            <div class="row" invisible="route_delivery_sms_provider in ('telnyx', 'infobip', 'bird')">
                                <label for="route_delivery_sms_account" class="col-lg-5"/>
                                <field name="route_delivery_sms_account" class="col-lg-7"/>
                            </div>
                            <div class="row">
                                <label for="route_delivery_sms_secret" class="col-lg-5"/>
                                <field name="route_delivery_sms_secret" class="col-lg-7" password="True"/>
                            </div>
                            <div class="row" invisible="route_delivery_sms_provider not in ('infobip', 'bird')">
                                <label for="route_delivery_sms_base_url" class="col-lg-5"/>
                                <field name="route_delivery_sms_base_url" class="col-lg-7" placeholder="xxxxx.api.infobip.com"/>
                            </div>
                            <div class="row">
                                <label for="route_delivery_sms_sender" class="col-lg-5"/>
                                <field name="route_delivery_sms_sender" class="col-lg-7"/>
                            </div>
                            <div class="row mt8">
                                <label for="route_delivery_sms_text_on_the_way" class="col-lg-5"/>
                                <field name="route_delivery_sms_text_on_the_way" class="col-lg-7"/>
                            </div>
                            <div class="row">
                                <label for="route_delivery_sms_text_next" class="col-lg-5"/>
                                <field name="route_delivery_sms_text_next" class="col-lg-7"/>
                            </div>
                            <div class="row">
                                <label for="route_delivery_sms_text_delivered" class="col-lg-5"/>
                                <field name="route_delivery_sms_text_delivered" class="col-lg-7"/>
                            </div>
                            <div class="row">
                                <label for="route_delivery_sms_text_failed" class="col-lg-5"/>
                                <field name="route_delivery_sms_text_failed" class="col-lg-7"/>
                            </div>
                            <div class="row mt8">
                                <label for="route_delivery_sms_test_number" class="col-lg-5"/>
                                <field name="route_delivery_sms_test_number" class="col-lg-4" placeholder="+54 9 11 ..."/>
                                <button name="action_route_delivery_sms_test" type="object" string="Enviar prueba" class="btn-link col-lg-3"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Prueba de entrega obligatoria"
                             help="Qué tiene que cargar el chofer para marcar una parada como entregada.">
                        <div class="content-group">
                            <div class="row mt8">
                                <field name="route_delivery_require_signature" class="col-1"/>
                                <label for="route_delivery_require_signature" class="col"/>
                            </div>
                            <div class="row">
                                <field name="route_delivery_require_photo" class="col-1"/>
                                <label for="route_delivery_require_photo" class="col"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Devoluciones en la entrega"
                             help="El chofer registra lo que el cliente le devuelve en la parada. Queda una recepción pendiente para que el depósito la controle al volver el vehículo.">
                        <field name="route_delivery_door_returns"/>
                    </setting>
                    <setting string="Carga del vehículo"
                             help="Control de lo que sube al vehículo antes de salir. La app muestra los bultos en orden de carga: lo último que se entrega, al fondo.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="route_delivery_load_control" class="col-lg-5"/>
                                <field name="route_delivery_load_control" class="col-lg-7"/>
                            </div>
                            <div class="row mt8" invisible="route_delivery_load_control == 'none'">
                                <field name="route_delivery_load_required" class="col-1"/>
                                <label for="route_delivery_load_required" class="col"/>
                            </div>
                            <div class="row" invisible="route_delivery_load_control == 'none'">
                                <field name="route_delivery_load_scan_only" class="col-1"/>
                                <label for="route_delivery_load_scan_only" class="col"/>
                            </div>
                            <div class="row">
                                <field name="route_delivery_unload_control" class="col-1"/>
                                <label for="route_delivery_unload_control" class="col"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Seguimiento y mapa"
                             help="Margen de la franja horaria que ve el cliente y mapa del tablero. Con Google Maps se suman tráfico en vivo y vista satelital.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="route_delivery_map_provider" class="col-lg-5"/>
                                <field name="route_delivery_map_provider" class="col-lg-7"/>
                            </div>
                            <div class="row" invisible="route_delivery_map_provider != 'google'">
                                <label for="route_delivery_google_maps_key" class="col-lg-5"/>
                                <field name="route_delivery_google_maps_key" class="col-lg-7" password="True"/>
                            </div>
                            <div class="row mt8">
                                <label for="route_delivery_eta_refresh_minutes" class="col-lg-5"/>
                                <field name="route_delivery_eta_refresh_minutes" class="col-lg-3"/>
                            </div>
                            <div class="row">
                                <label for="route_delivery_eta_window_minutes" class="col-lg-5"/>
                                <field name="route_delivery_eta_window_minutes" class="col-lg-3"/>
                            </div>
                            <div class="row" invisible="route_delivery_map_provider == 'google'">
                                <label for="route_delivery_tile_url" class="col-lg-5"/>
                                <field name="route_delivery_tile_url" class="col-lg-7"
                                       placeholder="https://tile.openstreetmap.org/{z}/{x}/{y}.png"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
