<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_batch_form_route_delivery" model="ir.ui.view">
        <field name="name">stock.picking.batch.form.route_delivery</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='batch_delivery_data']" position="inside">
                <field name="route_delivery_stop_count" invisible="1"/>
                <field name="route_delivery_progress" widget="progressbar" string="Avance del reparto"
                       invisible="not route_delivery_stop_count"/>
                <label for="route_delivery_done_count" string="Entregas"
                       invisible="not route_delivery_stop_count"/>
                <div invisible="not route_delivery_stop_count">
                    <field name="route_delivery_done_count" class="oe_inline"/> entregadas ·
                    <field name="route_delivery_failed_count" class="oe_inline"/> no entregadas ·
                    <field name="route_delivery_stop_count" class="oe_inline"/> paradas
                </div>
                <field name="route_delivery_started_at" invisible="not route_delivery_started_at"/>
                <field name="route_delivery_finished_at" invisible="not route_delivery_finished_at"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_route_delivery_update_etas" type="object"
                        string="Recalcular horas" class="btn-secondary"
                        invisible="not picking_ids or state == 'cancel'"
                        groups="stock.group_stock_user"/>
            </xpath>
        </field>
    </record>
</odoo>
