<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- Sin t-call con parámetros: OWL 2 los pasa con t-set y OWL 3 como atributos. -->
<t t-name="route_optimizer_delivery.RouteDeliveryApp">
    <div class="o_route_delivery_app">

        <!-- Estado de la conexión y de lo que falta enviar: a la vista en todas las pantallas -->
        <div t-if="!this.state.online or this.state.queue.length" t-attf-class="o_rd_sync {{ this.failedSync.length ? 'o_rd_sync_bad' : '' }}">
            <div class="o_rd_sync_text">
                <strong t-if="!this.state.online">Sin conexión.</strong>
                <t t-if="this.pendingSync.length">
                    <t t-out="this.pendingSync.length"/> <t t-if="this.pendingSync.length === 1">acción guardada</t><t t-else="">acciones guardadas</t> en el teléfono.
                </t>
                <t t-elif="!this.state.online"> Podés seguir repartiendo: se guarda en el teléfono.</t>
            </div>
            <button data-available-offline="" t-if="this.pendingSync.length and this.state.online" type="button" class="o_rd_sync_btn" t-on-click="this.sync" t-att-disabled="this.state.syncing">
                <t t-if="this.state.syncing">Enviando…</t><t t-else="">Enviar ahora</t>
            </button>
        </div>
        <div t-foreach="this.failedSync" t-as="item" t-key="item.id" class="o_rd_sync o_rd_sync_bad">
            <div class="o_rd_sync_text"><strong t-out="item.label"/>: no se pudo guardar. <t t-out="item.error"/></div>
            <button data-available-offline="" type="button" class="o_rd_sync_btn" t-on-click="() => this.discardSync(item)">Descartar</button>
        </div>

        <!-- Inicio: mis rutas -->
        <t t-if="this.state.screen === 'home'">
            <div class="o_rd_header o_rd_header_home">
                <div class="o_rd_app_icon" aria-hidden="true"><i class="o_rdi o_rdi-truck"/></div>
                <div class="flex-grow-1">
                    <div class="o_rd_title">Reparto</div>
                    <div class="o_rd_sub"><t t-out="this.todayLabel"/> · <t t-out="this.state.user"/></div>
                </div>
                <button data-available-offline="" type="button" class="o_rd_back" aria-label="Actualizar" t-on-click="this.loadRoutes" t-att-disabled="this.state.busy">
                    <i class="o_rdi o_rdi-refresh"/>
                </button>
            </div>
            <div class="o_rd_body">
                <button data-available-offline="" t-if="this.scannerSupported" type="button" class="o_rd_btn o_rd_btn_primary o_rd_btn_scan" t-on-click="this.scan" t-att-disabled="this.state.busy">
                    <i class="o_rdi o_rdi-qrcode me-2"/> Escanear remito
                </button>
                <button data-available-offline="" t-if="this.scannerSupported and !this.state.showManual" type="button" class="o_rd_link" t-on-click="this.toggleManual">
                    No puedo escanear: escribir el número
                </button>
                <form t-if="this.state.showManual or !this.scannerSupported" class="o_rd_manual" t-on-submit="this.submitManual">
                    <label class="o_rd_field_label" for="rd_manual_home">Número de remito o de ruta</label>
                    <div class="d-flex gap-2">
                        <input id="rd_manual_home" type="text" class="o_rd_input" autocapitalize="characters"
                               autocomplete="off" enterkeyhint="search" t-att-value="this.state.manualCode" t-on-input="(ev) => this.setValue(this.state, 'manualCode', ev)"/>
                        <button data-available-offline="" type="submit" class="o_rd_btn o_rd_btn_secondary o_rd_btn_inline" t-att-disabled="this.state.busy">Abrir</button>
                    </div>
                </form>

                <div t-if="!this.state.routes.length" class="o_rd_empty">
                    No tenés rutas asignadas para estos días. Cuando el depósito te asigne una como
                    responsable, aparece acá.
                </div>

                <div t-if="this.openRoutes.length" class="o_rd_section_title">Mis rutas</div>
                <t t-foreach="this.openRoutes" t-as="route" t-key="route.id">
                    <button data-available-offline="" type="button" t-attf-class="o_rd_card o_rd_card_button {{ route.started ? 'o_rd_card_active' : '' }}"
                            t-on-click="() => this.openRoute(route.id)">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <div class="o_rd_card_title" t-out="route.name"/>
                                <div class="o_rd_muted" t-out="this.routeSubtitle(route)"/>
                            </div>
                            <span t-if="route.started" class="o_rd_badge o_rd_badge_active">En curso</span>
                            <span t-else="" class="o_rd_badge o_rd_badge_idle">Sin salir</span>
                        </div>
                        <div class="d-flex justify-content-between o_rd_muted">
                            <span><t t-out="route.done_count + route.failed_count"/> de <t t-out="route.stop_count"/> paradas</span>
                            <span t-if="route.failed_count" class="o_rd_alert"><t t-out="route.failed_count"/> no entregadas</span>
                        </div>
                        <div class="o_rd_progress"><div t-attf-style="width: {{ route.progress }}%"/></div>
                        <div t-if="route.next_stop" class="o_rd_muted">Próxima: <strong t-out="route.next_stop"/></div>
                    </button>
                </t>

                <div t-if="this.finishedRoutes.length" class="o_rd_section_title">Terminadas</div>
                <t t-foreach="this.finishedRoutes" t-as="route" t-key="route.id">
                    <button data-available-offline="" type="button" class="o_rd_card o_rd_card_button" t-on-click="() => this.openRoute(route.id)">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <div class="o_rd_card_title" t-out="route.name"/>
                                <div class="o_rd_muted" t-out="this.routeSubtitle(route)"/>
                            </div>
                            <span class="o_rd_badge o_rd_badge_done">Terminada</span>
                        </div>
                        <div class="o_rd_muted">
                            <t t-out="route.done_count"/> entregadas<t t-if="route.failed_count"> · <t t-out="route.failed_count"/> no entregadas</t>
                        </div>
                    </button>
                </t>

                <div t-if="this.canInstall" class="o_rd_install">
                    <button data-available-offline="" type="button" class="o_rd_btn o_rd_btn_secondary" t-on-click="this.installApp">
                        <i class="o_rdi o_rdi-mobile me-2"/> Instalar en el celular
                    </button>
                    <div class="o_rd_hint">Queda con su ícono en la pantalla de inicio y abre directo acá.</div>
                </div>
            </div>
        </t>

        <!-- Ruta: paradas en orden de visita -->
        <t t-if="this.state.screen === 'route'">
            <div class="o_rd_header">
                <button data-available-offline="" type="button" class="o_rd_back" aria-label="Volver a mis rutas" t-on-click="this.goHome">
                    <i class="o_rdi o_rdi-chevron-left"/>
                </button>
                <div class="flex-grow-1">
                    <div class="o_rd_title" t-out="this.state.route.name"/>
                    <div class="o_rd_sub" t-out="this.routeSubtitle(this.state.route)"/>
                </div>
                <div class="o_rd_header_stats">
                    <div><strong t-out="this.state.route.done_count + this.state.route.failed_count"/> / <t t-out="this.state.route.stop_count"/></div>
                    <div>paradas</div>
                </div>
            </div>
            <div class="o_rd_body">
                <button data-available-offline="" t-if="this.loadOn and this.loadTotal and !this.state.route.finished" type="button"
                        t-attf-class="o_rd_card o_rd_card_button o_rd_loadcard {{ this.loadMissing ? '' : 'o_rd_loadcard_ok' }}" t-on-click="this.openLoad">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <div class="o_rd_card_title"><i class="o_rdi o_rdi-box me-2"/>Carga del vehículo</div>
                        <span t-if="this.loadMissing" class="o_rd_badge o_rd_badge_partial">Faltan <t t-out="this.loadMissing"/></span>
                        <span t-else="" class="o_rd_badge o_rd_badge_done">Completa</span>
                    </div>
                    <div class="o_rd_muted"><t t-out="this.loadTotal - this.loadMissing"/> de <t t-out="this.loadTotal"/> bultos arriba</div>
                    <div class="o_rd_progress"><div t-attf-style="width: {{ this.loadPercent }}%"/></div>
                </button>
                <div t-if="this.state.confirmLoad and !this.state.route.started" class="o_rd_partial o_rd_partial_inline" role="alert">
                    <strong>Faltan <t t-out="this.loadMissing"/> bultos sin cargar.</strong>
                    <div>Tocá de nuevo para salir igual: queda anotado en la ruta.</div>
                </div>
                <button data-available-offline="" t-if="!this.state.route.started and this.pendingStops.length" type="button"
                        t-attf-class="o_rd_btn o_rd_btn_scan {{ this.loadOn and this.loadMissing and !this.state.confirmLoad ? 'o_rd_btn_secondary' : 'o_rd_btn_primary' }}" t-on-click="this.startRoute" t-att-disabled="this.state.busy">
                    <i class="o_rdi o_rdi-play me-2"/> <t t-if="this.state.confirmLoad">Salir igual</t><t t-else="">Salir a repartir</t>
                </button>
                <div class="o_rd_actions o_rd_actions_2">
                    <button data-available-offline="" t-if="this.scannerSupported" type="button" class="o_rd_btn o_rd_btn_secondary" t-on-click="this.scan" t-att-disabled="this.state.busy">
                        <i class="o_rdi o_rdi-qrcode me-2"/> Escanear remito
                    </button>
                    <button data-available-offline="" t-else="" type="button" class="o_rd_btn o_rd_btn_secondary" t-on-click="this.toggleManual">
                        <i class="o_rdi o_rdi-keyboard-o me-2"/> Buscar remito
                    </button>
                    <button data-available-offline="" type="button" class="o_rd_btn o_rd_btn_secondary" t-att-disabled="!this.state.route.gmaps_url"
                            t-on-click="() => this.openMaps(this.state.route.gmaps_url)">
                        <i class="o_rdi o_rdi-map-o me-2"/> Ver recorrido
                    </button>
                </div>
                <button data-available-offline="" t-if="this.scannerSupported and !this.state.showManual" type="button" class="o_rd_link" t-on-click="this.toggleManual">
                    No puedo escanear: escribir el número
                </button>
                <form t-if="this.state.showManual" class="o_rd_manual" t-on-submit="this.submitManual">
                    <label class="o_rd_field_label" for="rd_manual_route">Número de remito</label>
                    <div class="d-flex gap-2">
                        <input id="rd_manual_route" type="text" class="o_rd_input" autocapitalize="characters"
                               autocomplete="off" enterkeyhint="search" t-att-value="this.state.manualCode" t-on-input="(ev) => this.setValue(this.state, 'manualCode', ev)"/>
                        <button data-available-offline="" type="submit" class="o_rd_btn o_rd_btn_secondary o_rd_btn_inline" t-att-disabled="this.state.busy">Abrir</button>
                    </div>
                </form>

                <div t-if="this.state.route.started and !this.state.route.finished" t-attf-class="o_rd_gps o_rd_gps_{{ this.state.gps }}">
                    <span class="o_rd_gps_dot" aria-hidden="true"/>
                    <t t-if="this.state.gps === 'on'">Compartiendo tu ubicación. Dejá la app abierta mientras repartís.</t>
                    <t t-elif="this.state.gps === 'off'">Sin ubicación: activá el GPS y el permiso de ubicación.</t>
                    <t t-else="">Buscando tu ubicación…</t>
                </div>
                <div t-if="this.state.route.finished" class="o_rd_card o_rd_card_done">
                    <div class="o_rd_card_title"><i class="o_rdi o_rdi-check-circle me-2"/>Ruta terminada</div>
                    <div class="o_rd_muted">
                        <t t-out="this.state.route.done_count"/> entregadas<t t-if="this.state.route.failed_count"> · <t t-out="this.state.route.failed_count"/> no entregadas</t>
                    </div>
                </div>

                <t t-foreach="this.state.route.stops" t-as="stop" t-key="stop.id">
                    <button data-available-offline="" type="button" t-on-click="() => this.openStop(stop.id)"
                            t-attf-class="o_rd_stop o_rd_stop_{{ stop.state }} {{ this.nextStop and this.nextStop.id === stop.id ? 'o_rd_stop_next' : '' }}">
                        <div class="o_rd_stop_num">
                            <i t-if="stop.state === 'delivered' or stop.state === 'partial'" class="o_rdi o_rdi-check"/>
                            <i t-elif="stop.state === 'failed'" class="o_rdi o_rdi-times"/>
                            <t t-else="" t-out="this.stopNumber(stop)"/>
                        </div>
                        <div class="o_rd_stop_main">
                            <div class="o_rd_stop_name"><span t-if="this.words(stop).tag" class="o_rd_kind" t-out="this.words(stop).tag"/><t t-out="stop.partner"/></div>
                            <div class="o_rd_muted" t-out="stop.address or stop.name"/>
                            <div t-if="stop.window" class="o_rd_muted"><i class="o_rdi o_rdi-clock-o me-1"/><t t-out="this.words(stop).window"/> <t t-out="stop.window"/></div>
                            <div t-if="stop.state === 'failed'" class="o_rd_alert" t-out="stop.fail_reason"/>
                        </div>
                        <div class="o_rd_stop_side">
                            <t t-if="stop.state === 'pending'">
                                <span t-if="this.nextStop and this.nextStop.id === stop.id" class="o_rd_badge o_rd_badge_active">Próxima</span>
                                <span t-if="stop.eta" class="o_rd_eta" t-out="this.hour(stop.eta)"/>
                            </t>
                            <t t-else="">
                                <span t-attf-class="o_rd_badge o_rd_badge_{{ stop.state }}" t-out="this.stateLabel(stop)"/>
                                <span t-if="this.isUnsynced(stop.id)" class="o_rd_badge o_rd_badge_idle">Sin enviar</span>
                                <span t-else="" class="o_rd_muted" t-out="this.hour(stop.done_at)"/>
                            </t>
                        </div>
                    </button>
                </t>
            </div>
        </t>

        <!-- Carga del vehículo: bultos en orden de carga -->
        <t t-if="this.state.screen === 'load'">
            <div class="o_rd_header">
                <button data-available-offline="" type="button" class="o_rd_back" aria-label="Volver a la ruta" t-on-click="this.backToRoute">
                    <i class="o_rdi o_rdi-chevron-left"/>
                </button>
                <div class="flex-grow-1">
                    <div class="o_rd_title">Carga del vehículo</div>
                    <div class="o_rd_sub" t-out="this.state.route.name"/>
                </div>
                <div class="o_rd_header_stats">
                    <div><strong t-out="this.loadTotal - this.loadMissing"/> / <t t-out="this.loadTotal"/></div>
                    <div>bultos</div>
                </div>
            </div>
            <div class="o_rd_body">
                <button data-available-offline="" t-if="this.scannerSupported and this.loadMissing" type="button" class="o_rd_btn o_rd_btn_primary o_rd_btn_scan" t-on-click="this.scanLoad" t-att-disabled="this.state.busy">
                    <i class="o_rdi o_rdi-barcode me-2"/> Escanear bultos
                </button>
                <form class="o_rd_manual" t-on-submit="this.submitLoadManual">
                    <label class="o_rd_field_label" for="rd_load_code">Código del bulto o del remito</label>
                    <div class="d-flex gap-2">
                        <input id="rd_load_code" type="text" class="o_rd_input" autocapitalize="characters"
                               autocomplete="off" enterkeyhint="done" t-att-value="this.state.manualCode" t-on-input="(ev) => this.setValue(this.state, 'manualCode', ev)"/>
                        <button data-available-offline="" type="submit" class="o_rd_btn o_rd_btn_secondary o_rd_btn_inline" t-att-disabled="this.state.busy">Cargar</button>
                    </div>
                </form>
                <div t-if="!this.loadMissing" class="o_rd_card o_rd_card_done">
                    <div class="o_rd_card_title"><i class="o_rdi o_rdi-check-circle me-2"/>Carga completa</div>
                    <div class="o_rd_muted">Está todo arriba. Ya podés salir.</div>
                </div>
                <div class="o_rd_hint">Orden de carga: primero lo que se entrega último, que va al fondo.</div>
                <t t-foreach="this.loadGroups" t-as="group" t-key="group.stop.id">
                    <div t-attf-class="o_rd_loadgroup {{ this.groupLoaded(group) ? 'o_rd_loadgroup_ok' : '' }}">
                        <div class="o_rd_loadgroup_head">
                            <span class="o_rd_loadgroup_num" t-out="group.number"/>
                            <div class="o_rd_stop_main">
                                <div class="o_rd_stop_name" t-out="group.stop.partner"/>
                                <div class="o_rd_muted">Parada <t t-out="group.number"/><t t-if="group.place"> · <t t-out="group.place"/></t></div>
                            </div>
                        </div>
                        <button data-available-offline="" type="button" t-foreach="group.items" t-as="item" t-key="item.key"
                                t-attf-class="o_rd_loaditem {{ item.loaded ? 'o_rd_loaditem_ok' : '' }}"
                                t-att-aria-pressed="item.loaded ? 'true' : 'false'" t-on-click="() => this.toggleLoad(item)">
                            <i t-attf-class="o_rdi {{ item.loaded ? 'o_rdi-check-circle' : 'o_rdi-circle-o' }} me-2"/>
                            <span class="o_rd_loaditem_code" t-out="item.label"/>
                            <span class="o_rd_muted"><t t-if="item.type"><t t-out="item.type"/> · </t><t t-if="item.weight"><t t-out="this.num(item.weight)"/> kg</t></span>
                        </button>
                    </div>
                </t>
            </div>
            <div class="o_rd_footer">
                <button data-available-offline="" type="button" class="o_rd_btn o_rd_btn_secondary o_rd_btn_scan" t-on-click="this.backToRoute">
                    Volver a la ruta
                </button>
            </div>
        </t>

        <!-- Parada -->
        <t t-if="this.state.screen === 'stop'">
            <t t-set="stop" t-value="this.currentStop"/>
            <t t-set="w" t-value="this.words(stop)"/>
            <div class="o_rd_header">
                <button data-available-offline="" type="button" class="o_rd_back" aria-label="Volver a la ruta" t-on-click="this.backToRoute">
                    <i class="o_rdi o_rdi-chevron-left"/>
                </button>
                <div class="flex-grow-1">
                    <div class="o_rd_title" t-out="stop.partner"/>
                    <div class="o_rd_sub"><t t-if="w.tag"><t t-out="w.tag"/> · </t><t t-out="stop.name"/><t t-if="stop.origin"> · <t t-out="stop.origin"/></t></div>
                </div>
                <div t-if="stop.state === 'pending' and stop.eta" class="o_rd_header_stats">
                    <div><strong t-out="this.hour(stop.eta)"/></div>
                    <div>estimado</div>
                </div>
            </div>
            <div class="o_rd_body">
                <div class="o_rd_card">
                    <div t-if="stop.address" class="o_rd_address" t-out="stop.address"/>
                    <div t-if="stop.window" class="o_rd_muted"><i class="o_rdi o_rdi-clock-o me-1"/><t t-out="w.window"/> <t t-out="stop.window"/></div>
                    <div t-if="stop.note" class="o_rd_note" t-out="stop.note"/>
                    <div class="o_rd_actions">
                        <a t-att-href="stop.maps_url or undefined" target="_blank" rel="noopener"
                           t-attf-class="o_rd_btn o_rd_btn_secondary o_rd_btn_link {{ stop.maps_url ? '' : 'disabled' }}">
                            <i class="o_rdi o_rdi-location-arrow"/> Ir
                        </a>
                        <a t-att-href="stop.phone ? 'tel:' + stop.phone : undefined"
                           t-attf-class="o_rd_btn o_rd_btn_secondary o_rd_btn_link {{ stop.phone ? '' : 'disabled' }}">
                            <i class="o_rdi o_rdi-phone"/> Llamar
                        </a>
                        <a t-att-href="stop.whatsapp_url or undefined" target="_blank" rel="noopener"
                           t-attf-class="o_rd_btn o_rd_btn_secondary o_rd_btn_link {{ stop.whatsapp_url ? '' : 'disabled' }}">
                            <i class="o_rdi o_rdi-whatsapp"/> Avisar
                        </a>
                    </div>
                </div>

                <!-- Ya visitada: resumen y corrección -->
                <t t-if="stop.state !== 'pending'">
                    <div t-attf-class="o_rd_card o_rd_result_{{ stop.state }}">
                        <div class="o_rd_card_title">
                            <t t-out="this.stateLabel(stop)"/> · <t t-out="this.hour(stop.done_at)"/>
                        </div>
                        <div t-if="stop.fail_reason" t-out="stop.fail_reason"/>
                        <div t-if="stop.receiver_name"><t t-out="w.person"/> <t t-out="stop.receiver_name"/><t t-if="stop.receiver_doc"> · DNI <t t-out="stop.receiver_doc"/></t></div>
                        <div t-if="stop.delivered_packages"><t t-out="stop.delivered_packages"/> bultos</div>
                        <div t-if="stop.cod_amount">Cobrado $ <t t-out="this.num(stop.cod_amount)"/></div>
                        <div t-if="stop.partial_detail" class="o_rd_pre" t-out="stop.partial_detail"/>
                        <div t-if="stop.return_detail" class="o_rd_returned"><strong>El cliente devolvió</strong><div class="o_rd_pre" t-out="stop.return_detail"/></div>
                        <div t-if="stop.driver_note" class="o_rd_muted" t-out="stop.driver_note"/>
                        <div class="o_rd_muted">
                            <t t-if="stop.photo_count"><t t-out="stop.photo_count"/> fotos</t>
                            <t t-if="stop.photo_count and stop.has_signature"> · </t>
                            <t t-if="stop.has_signature">con firma</t>
                        </div>
                    </div>
                    <button data-available-offline="" type="button" class="o_rd_link" t-on-click="this.reopen" t-att-disabled="this.state.busy">
                        Me equivoqué: corregir esta parada
                    </button>
                </t>

                <!-- Pendiente: prueba de entrega -->
                <t t-else="">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="o_rd_section_title" t-out="w.what"/>
                        <span t-if="this.scanTargets.length" class="o_rd_muted">
                            <t t-out="this.checkedCount"/> de <t t-out="this.scanTargets.length"/> controlados
                        </span>
                    </div>
                    <button data-available-offline="" t-if="this.scanTargets.length and this.scannerSupported" type="button"
                            class="o_rd_btn o_rd_btn_secondary" t-on-click="this.scanItem">
                        <i class="o_rdi o_rdi-barcode me-2"/> Escanear <t t-if="stop.packages.length">bultos</t><t t-else="">productos</t>
                    </button>
                    <div t-if="stop.packages.length" class="o_rd_chips">
                        <button data-available-offline="" type="button" t-foreach="stop.packages" t-as="pack" t-key="pack.key" t-on-click="() => this.togglePackage(pack)"
                              t-attf-class="o_rd_chip {{ this.state.checked[pack.code] ? 'o_rd_chip_ok' : '' }} {{ this.packageNotLoaded(stop, pack) ? 'o_rd_chip_warn' : '' }}">
                            <i t-if="this.state.checked[pack.code]" class="o_rdi o_rdi-check me-1"/><t t-out="pack.label"/><t t-if="pack.type"> · <t t-out="pack.type"/></t>
                            <t t-if="this.packageNotLoaded(stop, pack)"> · no se cargó</t>
                        </button>
                    </div>
                    <div t-foreach="stop.lines" t-as="line" t-key="line.id"
                         t-attf-class="o_rd_line {{ this.lineShort(line) ? 'o_rd_line_short' : '' }}">
                        <label class="o_rd_line_label" t-attf-for="rd_qty_{{ line.id }}">
                            <i t-if="line.barcode and this.state.checked[line.barcode]" class="o_rdi o_rdi-check o_rd_check me-1"/>
                            <t t-out="line.product"/>
                        </label>
                        <div class="o_rd_line_qty">
                            <input type="text" class="o_rd_number" autocomplete="off" enterkeyhint="next"
                                   t-attf-id="rd_qty_{{ line.id }}"
                                   t-att-inputmode="line.integer ? 'numeric' : 'decimal'"
                                   t-att-value="this.state.form.qty[line.id]" t-on-input="(ev) => this.setValue(this.state.form.qty, line.id, ev)"
                                   t-on-focus="this.selectOnFocus"
                                   t-on-blur="(ev) => this.onQtyBlur(line, ev)"/>
                            <span class="o_rd_muted">de <t t-out="this.num(line.qty)"/> <t t-out="line.uom"/></span>
                        </div>
                    </div>
                    <div t-if="!stop.lines.length" class="o_rd_empty">Este remito no tiene productos cargados.</div>

                    <t t-if="stop.returnable and stop.returnable.length">
                        <button data-available-offline="" type="button" class="o_rd_btn o_rd_btn_secondary" t-on-click="this.toggleReturns"
                                t-att-aria-expanded="this.state.form.showReturns ? 'true' : 'false'">
                            <i class="o_rdi o_rdi-undo me-2"/>
                            <t t-if="this.returnLines.length">Devuelve <t t-out="this.returnLines.length"/> producto(s)</t>
                            <t t-else="">El cliente devuelve mercadería</t>
                        </button>
                        <div t-if="this.state.form.showReturns" class="o_rd_card o_rd_returns">
                            <div class="o_rd_hint">Cargá solo lo que te llevás. El depósito lo controla cuando volvés.</div>
                            <div t-foreach="stop.returnable" t-as="item" t-key="item.id" class="o_rd_line">
                                <label class="o_rd_line_label" t-attf-for="rd_ret_{{ item.id }}" t-out="item.product"/>
                                <div class="o_rd_line_qty">
                                    <input type="text" class="o_rd_number" autocomplete="off" enterkeyhint="next" placeholder="0"
                                           t-attf-id="rd_ret_{{ item.id }}"
                                           t-att-inputmode="item.integer ? 'numeric' : 'decimal'"
                                           t-att-value="this.state.form.returns[item.id] or ''"
                                           t-on-input="(ev) => this.setValue(this.state.form.returns, item.id, ev)"
                                           t-on-focus="this.selectOnFocus"
                                           t-on-blur="(ev) => this.onReturnBlur(item, ev)"/>
                                    <span class="o_rd_muted" t-out="item.uom"/>
                                </div>
                            </div>
                            <div>
                                <label class="o_rd_field_label" for="rd_ret_note">Motivo de la devolución (opcional)</label>
                                <input id="rd_ret_note" type="text" class="o_rd_input" autocomplete="off" enterkeyhint="done"
                                       t-att-value="this.state.form.returnNote" t-on-input="(ev) => this.setValue(this.state.form, 'returnNote', ev)"/>
                            </div>
                        </div>
                    </t>

                    <div class="o_rd_section_title" t-out="w.who"/>
                    <div class="o_rd_card">
                        <div>
                            <label class="o_rd_field_label" for="rd_receiver">Nombre y apellido</label>
                            <input id="rd_receiver" type="text" class="o_rd_input" autocomplete="off"
                                   autocapitalize="words" enterkeyhint="next" t-att-value="this.state.form.receiverName" t-on-input="(ev) => this.setValue(this.state.form, 'receiverName', ev)"/>
                        </div>
                        <div class="o_rd_grid_2">
                            <div>
                                <label class="o_rd_field_label" for="rd_doc">DNI</label>
                                <input id="rd_doc" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="11"
                                       class="o_rd_input" autocomplete="off" enterkeyhint="next"
                                       t-att-value="this.state.form.receiverDoc"
                                       t-on-input="(ev) => this.onDigitsInput('receiverDoc', ev)"/>
                            </div>
                            <div>
                                <label class="o_rd_field_label" for="rd_packages">Bultos</label>
                                <input id="rd_packages" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="4"
                                       class="o_rd_input" autocomplete="off" enterkeyhint="next"
                                       t-att-value="this.state.form.packages"
                                       t-on-focus="this.selectOnFocus"
                                       t-on-input="(ev) => this.onDigitsInput('packages', ev)"/>
                            </div>
                        </div>
                        <div>
                            <label class="o_rd_field_label" for="rd_cod" t-out="w.cod"/>
                            <input id="rd_cod" type="text" inputmode="decimal" class="o_rd_input" autocomplete="off"
                                   placeholder="0" enterkeyhint="done"
                                   t-att-value="this.state.form.cod" t-on-input="(ev) => this.setValue(this.state.form, 'cod', ev)"
                                   t-on-focus="this.selectOnFocus"
                                   t-on-blur="(ev) => this.onDecimalBlur('cod', ev)"/>
                        </div>
                    </div>

                    <div class="o_rd_section_title">
                        Foto<t t-if="this.state.route.require_photo"> (obligatoria)</t>
                    </div>
                    <div class="o_rd_photos">
                        <div t-foreach="this.state.form.photos" t-as="photo" t-key="photo_index" class="o_rd_photo">
                            <img t-att-src="photo" alt="Foto de la entrega"/>
                            <button data-available-offline="" type="button" aria-label="Quitar foto" t-on-click="() => this.removePhoto(this.state.form, photo_index)">
                                <i class="o_rdi o_rdi-times"/>
                            </button>
                        </div>
                        <label class="o_rd_photo_add">
                            <i class="o_rdi o_rdi-camera" aria-hidden="true"/>
                            <span>Sacar foto</span>
                            <input type="file" accept="image/*" capture="environment" class="d-none"
                                   t-on-change="(ev) => this.addPhoto(this.state.form, ev)"/>
                        </label>
                    </div>

                    <div class="o_rd_section_title">
                        Firma<t t-if="this.state.route.require_signature"> (obligatoria)</t>
                    </div>
                    <div class="o_rd_signature">
                        <canvas class="o_rd_signature_canvas"
                                t-on-pointerdown="this.onSignatureDown" t-on-pointermove="this.onSignatureMove"
                                t-on-pointerup="this.onSignatureUp" t-on-pointercancel="this.onSignatureUp" t-on-pointerleave="this.onSignatureUp"/>
                        <div t-if="!this.state.form.signature" class="o_rd_signature_hint">Firmá acá con el dedo</div>
                        <button data-available-offline="" t-if="this.state.form.signature" type="button" class="o_rd_signature_clear" t-on-click="this.clearSignature">Borrar</button>
                    </div>

                    <div>
                        <label class="o_rd_field_label" for="rd_note">Comentario (opcional)</label>
                        <textarea id="rd_note" class="o_rd_input o_rd_textarea" rows="2" t-att-value="this.state.form.note" t-on-input="(ev) => this.setValue(this.state.form, 'note', ev)"/>
                    </div>
                </t>
            </div>
            <div t-if="stop.state === 'pending' and this.state.confirmPartial" class="o_rd_partial" role="alert">
                <t t-if="this.isPartial">
                    <strong t-out="w.notAll"/>
                    <div t-out="this.partialSummary"/>
                </t>
                <t t-if="this.unscannedPackages.length">
                    <strong>Faltan escanear <t t-out="this.unscannedPackages.length"/> bultos.</strong>
                    <div t-out="this.unscannedPackages.join(' · ')"/>
                </t>
                <div t-if="this.isPartial" t-out="w.confirmHint"/>
                <div t-else="">Tocá de nuevo para confirmar igual.</div>
            </div>
            <div t-if="stop.state === 'pending'" class="o_rd_footer">
                <button data-available-offline="" type="button" class="o_rd_btn o_rd_btn_primary o_rd_btn_scan" t-on-click="this.deliver" t-att-disabled="this.state.busy">
                    <i class="o_rdi o_rdi-check me-2"/>
                    <t t-if="this.state.confirmPartial and this.isPartial" t-out="w.confirmPartial"/>
                    <t t-elif="this.state.confirmPartial">Confirmar igual</t>
                    <t t-elif="this.isPartial" t-out="w.partial"/>
                    <t t-else="" t-out="w.done"/>
                </button>
                <button data-available-offline="" type="button" class="o_rd_btn o_rd_btn_danger" t-on-click="this.openFail" t-att-disabled="this.state.busy">
                    <t t-out="w.failed"/>
                </button>
            </div>
        </t>

        <!-- No entregado: motivo -->
        <t t-if="this.state.screen === 'fail'">
            <t t-set="stop" t-value="this.currentStop"/>
            <t t-set="w" t-value="this.words(stop)"/>
            <div class="o_rd_header">
                <button data-available-offline="" type="button" class="o_rd_back" aria-label="Volver a la parada" t-on-click="this.backToStop">
                    <i class="o_rdi o_rdi-chevron-left"/>
                </button>
                <div>
                    <div class="o_rd_title" t-out="w.failed"/>
                    <div class="o_rd_sub" t-out="stop.partner"/>
                </div>
            </div>
            <div class="o_rd_body">
                <div class="o_rd_section_title">¿Qué pasó?</div>
                <button data-available-offline="" t-foreach="this.state.route.reasons" t-as="reason" t-key="reason.id" type="button"
                        t-attf-class="o_rd_reason {{ this.state.fail.reasonId === reason.id ? 'o_rd_reason_on' : '' }}"
                        t-att-aria-pressed="this.state.fail.reasonId === reason.id ? 'true' : 'false'"
                        t-on-click="() => this.state.fail.reasonId = reason.id">
                    <i t-attf-class="o_rdi {{ this.state.fail.reasonId === reason.id ? 'o_rdi-dot-circle-o' : 'o_rdi-circle-o' }} me-2"/>
                    <t t-out="reason.name"/>
                </button>
                <div>
                    <label class="o_rd_field_label" for="rd_fail_note">
                        Aclaración<t t-if="this.failReason and this.failReason.require_note"> (obligatoria)</t><t t-else=""> (opcional)</t>
                    </label>
                    <textarea id="rd_fail_note" class="o_rd_input o_rd_textarea" rows="3" t-att-value="this.state.fail.note" t-on-input="(ev) => this.setValue(this.state.fail, 'note', ev)"/>
                </div>
                <div class="o_rd_section_title">Foto (opcional)</div>
                <div class="o_rd_photos">
                    <div t-foreach="this.state.fail.photos" t-as="photo" t-key="photo_index" class="o_rd_photo">
                        <img t-att-src="photo" alt="Foto de la entrega"/>
                        <button data-available-offline="" type="button" aria-label="Quitar foto" t-on-click="() => this.removePhoto(this.state.fail, photo_index)">
                            <i class="o_rdi o_rdi-times"/>
                        </button>
                    </div>
                    <label class="o_rd_photo_add">
                        <i class="o_rdi o_rdi-camera" aria-hidden="true"/>
                        <span>Sacar foto</span>
                        <input type="file" accept="image/*" capture="environment" class="d-none"
                               t-on-change="(ev) => this.addPhoto(this.state.fail, ev)"/>
                    </label>
                </div>
            </div>
            <div class="o_rd_footer">
                <button data-available-offline="" type="button" class="o_rd_btn o_rd_btn_danger_solid o_rd_btn_scan" t-on-click="this.confirmFail" t-att-disabled="this.state.busy">
                    Confirmar <t t-out="w.failed.toLowerCase()"/>
                </button>
            </div>
        </t>
    </div>
</t>

</templates>
