<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List embedded in batch form → Transfers tab: clarify drag handle = visit order -->
    <record id="stock_picking_view_batch_tree_route_optimizer" model="ir.ui.view">
        <field name="name">stock.picking.list.batch.route_optimizer</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_view_batch_tree_ref"/>
        <field name="arch" type="xml">
            <field name="batch_sequence" position="attributes">
                <attribute name="string">Visit order</attribute>
            </field>
            <field name="batch_sequence" position="after">
                <field name="route_optimizer_delivery_address" string="Address" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
