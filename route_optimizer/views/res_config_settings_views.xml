<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_route_optimizer" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.route_optimizer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Optimización de rutas" name="route_optimizer_block">
                    <setting id="route_optimizer_osrm_setting" string="Servidor OSRM" help="Solo la URL raíz del servidor OSRM (ej. http://IP:5000). No agregar /table/v1/ — Odoo arma esa ruta automáticamente.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_osrm_url"/>
                                <field name="route_optimizer_osrm_url" class="oe_inline" placeholder="http://HOST:5000"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_osrm_profile"/>
                                <field name="route_optimizer_osrm_profile" class="oe_inline"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="route_optimizer_ortools_setting" string="Servicio OR-Tools" help="URL base (IP:puerto) o endpoint completo. Odoo agrega /optimize o /vrp automáticamente. Con ventanas horarias OCA y optimización por duración, cada parada usa la fecha planificada del traslado (día y hora) y las ventanas del cliente se envían a /vrp.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_ortools_url"/>
                                <field name="route_optimizer_ortools_url" class="oe_inline" placeholder="http://HOST:8080  (Odoo agrega /optimize o /vrp automáticamente)"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_ortools_api_key"/>
                                <field name="route_optimizer_ortools_api_key" class="oe_inline" password="True" placeholder="(opcional)"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_ortools_simple_api"/>
                                <field name="route_optimizer_ortools_simple_api"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_timeout"/>
                                <field name="route_optimizer_timeout" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_max_stops_per_vehicle"/>
                                <field name="route_optimizer_max_stops_per_vehicle" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_max_route_duration_minutes"/>
                                <field name="route_optimizer_max_route_duration_minutes" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_use_delivery_windows"/>
                                <field name="route_optimizer_use_delivery_windows"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_route_start_hour"/>
                                <field name="route_optimizer_route_start_hour" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_service_time_seconds"/>
                                <field name="route_optimizer_service_time_seconds" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_block_outside_windows"/>
                                <field name="route_optimizer_block_outside_windows"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
