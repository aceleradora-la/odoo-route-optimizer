<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_route_optimizer" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.route_optimizer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Route optimization" name="route_optimizer_block">
                    <setting id="route_optimizer_osrm_setting" string="OSRM server" help="Root URL of the OSRM server only (e.g. http://IP:5000). Do not add /table/v1/ — Odoo builds that path automatically.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_osrm_url"/>
                                <field name="route_optimizer_osrm_url" class="oe_inline" placeholder="http://HOST:5000"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_osrm_profile"/>
                                <field name="route_optimizer_osrm_profile" class="oe_inline"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="route_optimizer_ortools_setting" string="OR-Tools service" help="Base URL (IP:port) or full endpoint. Odoo will automatically use /optimize when Simple OR-Tools API is enabled, or /vrp when disabled. If you paste a full URL with /optimize or /vrp it will be respected when it matches the selected mode. For delivery time windows (OCA stock_partner_delivery_window), Odoo uses the batch Scheduled date to pick the weekday and sends a single [start,end] window per stop (union of multiple windows).">
                        <div class="content-group">
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_ortools_url"/>
                                <field name="route_optimizer_ortools_url" class="oe_inline" placeholder="http://HOST:8080  (Odoo agrega /optimize o /vrp automáticamente)"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_ortools_api_key"/>
                                <field name="route_optimizer_ortools_api_key" class="oe_inline" password="True" placeholder="(optional)"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_ortools_simple_api"/>
                                <field name="route_optimizer_ortools_simple_api"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_timeout"/>
                                <field name="route_optimizer_timeout" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_max_stops_per_vehicle"/>
                                <field name="route_optimizer_max_stops_per_vehicle" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="route_optimizer_max_route_duration_minutes"/>
                                <field name="route_optimizer_max_route_duration_minutes" class="oe_inline"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
