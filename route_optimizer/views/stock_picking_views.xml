<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_route_optimizer" model="ir.ui.view">
        <field name="name">stock.picking.form.route_optimizer</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_route_optimizer_from_picking"
                    type="object"
                    string="Optimizar ruta del lote"
                    class="btn-secondary"
                    invisible="not batch_id or state in ('done', 'cancel')"
                />
            </xpath>
        </field>
    </record>
</odoo>
