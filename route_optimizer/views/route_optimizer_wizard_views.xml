<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_route_optimizer_wizard_form" model="ir.ui.view">
        <field name="name">route.optimizer.wizard.form</field>
        <field name="model">route.optimizer.wizard</field>
        <field name="arch" type="xml">
            <form string="Optimizar ruta">
                <group>
                    <field name="batch_id" readonly="1"/>
                    <field name="num_vehicles"/>
                    <field name="use_duration"/>
                    <field name="depot_partner_id"/>
                    <field name="vehicle_capacity"/>
                    <field name="vehicle_volume_capacity"/>
                    <field name="max_stops_per_vehicle"/>
                    <field name="max_route_duration_minutes"/>
                </group>
                <footer>
                    <button name="action_optimize" string="Optimizar" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
