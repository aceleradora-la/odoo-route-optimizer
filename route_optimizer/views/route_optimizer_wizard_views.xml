<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_route_optimizer_wizard_form" model="ir.ui.view">
        <field name="name">route.optimizer.wizard.form</field>
        <field name="model">route.optimizer.wizard</field>
        <field name="arch" type="xml">
            <form string="Optimizar ruta">
                <field name="batch_id" invisible="1"/>
                <div class="alert alert-info mb-3" role="status">
                    Ordena las paradas del lote para recorrer menos. Con más de un vehículo,
                    el lote se reparte en una ruta por vehículo.
                </div>
                <group>
                    <group string="Vehículos" name="vehicles">
                        <field name="num_vehicles"/>
                        <label for="vehicle_capacity"/>
                        <div class="o_row"><field name="vehicle_capacity" class="oe_inline"/> <span>kg por vehículo</span></div>
                        <label for="vehicle_volume_capacity"/>
                        <div class="o_row"><field name="vehicle_volume_capacity" class="oe_inline"/> <span>m³ por vehículo</span></div>
                    </group>
                    <group string="Recorrido" name="route">
                        <field name="depot_partner_id" options="{'no_create': True}"/>
                        <field name="use_duration" widget="boolean_toggle"/>
                        <label for="max_stops_per_vehicle"/>
                        <div class="o_row"><field name="max_stops_per_vehicle" class="oe_inline"/> <span>paradas (0 = sin tope)</span></div>
                        <label for="max_route_duration_minutes"/>
                        <div class="o_row"><field name="max_route_duration_minutes" class="oe_inline"/> <span>minutos (0 = sin tope)</span></div>
                    </group>
                </group>
                <group string="Flota con capacidades distintas" name="fleet_lines">
                    <field name="vehicle_line_ids" nolabel="1" colspan="2">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name" placeholder="Patente o nombre"/>
                            <field name="capacity"/>
                            <field name="volume_capacity"/>
                        </tree>
                    </field>
                </group>
                <div class="text-muted mb-2">
                    Con renglones cargados, cada uno es un vehículo con su propia capacidad y se
                    ignoran «Vehículos» y las capacidades de arriba.
                </div>
                <footer>
                    <button name="action_optimize" string="Optimizar" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
