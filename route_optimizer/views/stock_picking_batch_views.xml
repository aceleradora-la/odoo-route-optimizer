<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_batch_form_route_optimizer" model="ir.ui.view">
        <field name="name">stock.picking.batch.form.route_optimizer</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_print_delivery_route"
                    type="object"
                    string="Print route"
                    class="btn-secondary"
                    invisible="not picking_ids"
                />
                <button
                    name="action_route_optimizer_wizard"
                    type="object"
                    string="Optimize route"
                    class="btn-secondary"
                    invisible="state in ('done', 'cancel')"
                />
            </xpath>
            <!-- many2many widget ignores list default_order; use one2many list so batch_sequence = visit order -->
            <xpath expr="//page[@name='page_transfers']//field[@name='picking_ids']" position="attributes">
                <attribute name="widget" remove="1"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group
                    string="Route optimization"
                    invisible="not route_optimizer_last_message and not route_optimizer_visit_summary"
                >
                    <field name="route_optimizer_last_message" readonly="1"/>
                    <field
                        name="route_optimizer_visit_summary"
                        readonly="1"
                        widget="text"
                        placeholder="Run Optimize route to fill the visit order."
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
