<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formato de papel propio de la hoja de ruta.

         Sin esto el reporte usa el formato por defecto de la compañía, que suele
         reservar margen superior para un encabezado corporativo alto. Como la
         hoja de ruta trae su propio header compacto (logo fijo de 55 px, ver
         batch_delivery_route_templates.xml), ese margen quedaba de más y dejaba
         varios centímetros en blanco antes del título.

         El "European A4" de Odoo usa margin_top 40 / header_spacing 35, pensado
         para un encabezado de ~35 mm. El de este reporte mide ~20 mm, así que se
         bajan ambos manteniendo la misma diferencia de 5 mm.

         PARA AJUSTAR: si el encabezado llegara a pisar el título, subir
         margin_top y header_spacing juntos (de a 5 mm) para conservar esa
         diferencia. -->
    <record id="paperformat_batch_delivery_route" model="report.paperformat">
        <field name="name">Hoja de ruta (A4)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">25</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_batch_delivery_route" model="ir.actions.report">
        <field name="name">Hoja de ruta (orden de visita)</field>
        <field name="model">stock.picking.batch</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">route_optimizer.report_batch_delivery_route</field>
        <field name="report_file">route_optimizer.report_batch_delivery_route</field>
        <field name="print_report_name">'Hoja de ruta - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_batch_delivery_route"/>
        <field name="binding_model_id" ref="stock_picking_batch.model_stock_picking_batch"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
