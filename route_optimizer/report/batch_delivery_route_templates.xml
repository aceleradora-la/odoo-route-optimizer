<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_batch_delivery_route">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Encabezado -->
                        <div class="row mb-1">
                            <div class="col-9">
                                <h2 style="margin-bottom:4px;">
                                    Hoja de Ruta — <span t-field="o.name"/>
                                </h2>
                                <t t-set="visit_pickings" t-value="o._route_optimizer_pickings_visit_order().filtered(lambda p: p.state != 'cancel')"/>
                                <t t-set="total_weight" t-value="sum(p.shipping_weight or 0 for p in visit_pickings)"/>
                                <span style="font-size:12px;">
                                    <t t-if="o.user_id">
                                        <strong>Responsable:</strong>
                                        <span t-field="o.user_id"/>
                                        &amp;nbsp;·&amp;nbsp;
                                    </t>
                                    <t t-if="o.scheduled_date">
                                        <strong>Fecha:</strong>
                                        <span t-field="o.scheduled_date"/>
                                        &amp;nbsp;·&amp;nbsp;
                                    </t>
                                    <strong>Paradas:</strong>
                                    <span t-esc="len(visit_pickings)"/>
                                    <t t-if="total_weight">
                                        &amp;nbsp;·&amp;nbsp;
                                        <strong>Peso total:</strong>
                                        <span t-esc="'%.1f kg' % total_weight"/>
                                    </t>
                                </span>
                            </div>
                            <!-- QR code Google Maps (solo si hay ruta optimizada) -->
                            <div class="col-3 text-right" t-if="o.route_optimizer_gmaps_qr_src">
                                <img t-att-src="o.route_optimizer_gmaps_qr_src"
                                     style="width:90px; height:90px;"
                                     title="Abrir ruta en Google Maps"/>
                                <div style="font-size:8px; color:#555; margin-top:2px;">Ruta Google Maps</div>
                            </div>
                        </div>

                        <!-- Tabla de paradas -->
                        <table class="table table-sm o_main_table mt-1" style="font-size:11px;">
                            <thead>
                                <tr>
                                    <th style="width:4%">#</th>
                                    <th style="width:18%">Cliente</th>
                                    <th style="width:9%">Teléfono</th>
                                    <th style="width:25%">Dirección</th>
                                    <th style="width:29%">Productos</th>
                                    <th style="width:9%">Ventana</th>
                                    <th style="width:6%">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="visit_pickings" t-as="pick">
                                    <tr>
                                        <td style="font-weight:bold; color:#1565C0;">
                                            <span t-field="pick.batch_sequence"/>
                                        </td>
                                        <td>
                                            <span t-field="pick.partner_id"/>
                                        </td>
                                        <td style="white-space:nowrap;">
                                            <span t-esc="pick.route_optimizer_partner_phone"/>
                                        </td>
                                        <td>
                                            <span t-esc="pick.route_optimizer_delivery_address"/>
                                        </td>
                                        <td style="font-size:10px;">
                                            <span t-esc="pick.route_optimizer_products_summary"/>
                                        </td>
                                        <td style="white-space:nowrap; font-size:10px;">
                                            <span t-esc="pick.route_optimizer_time_window"/>
                                        </td>
                                        <td>
                                            <span t-field="pick.state"/>
                                        </td>
                                    </tr>
                                    <!-- Fila de notas (solo si existe) -->
                                    <tr t-if="pick.note">
                                        <td/>
                                        <td colspan="6" style="font-size:10px; color:#555; padding-top:0; border-top:none;">
                                            <i><span t-field="pick.note" t-options='{"widget": "text"}'/></i>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="font-weight:bold; border-top: 2px solid #333;">
                                    <td colspan="2">
                                        Total: <span t-esc="len(visit_pickings)"/> paradas
                                    </td>
                                    <td colspan="2"/>
                                    <td colspan="3" t-if="total_weight">
                                        Peso: <span t-esc="'%.1f kg' % total_weight"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Bloque de firma -->
                        <div class="row mt-4">
                            <div class="col-5">
                                <div style="border-top: 1px solid #333; margin-top: 40px; padding-top: 4px; font-size:10px;">
                                    Firma del transportista
                                </div>
                            </div>
                            <div class="col-2"/>
                            <div class="col-5">
                                <div style="border-top: 1px solid #333; margin-top: 40px; padding-top: 4px; font-size:10px;">
                                    Fecha / Hora
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
