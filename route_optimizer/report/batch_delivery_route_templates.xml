<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_batch_delivery_route">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id.sudo() if o.company_id else env.company"/>
                <!-- Header propio compacto: a propósito NO se usa
                     web.external_layout — el header corporativo toma el alto
                     de logo configurable por empresa (report_layout_extras)
                     y en un documento operativo el logo debe mantener un
                     tamaño fijo. -->
                <div class="header">
                    <div class="row align-items-center">
                        <div class="col-6">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 55px; max-width: 180px;" alt="Logo"/>
                        </div>
                        <div class="col-6 text-end" style="font-size: 9px; line-height: 1.3; color: #444;">
                            <strong t-field="company.name"/>
                            <div t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                            <div t-if="company.vat">
                                <t t-esc="company.country_id.vat_label or 'CUIT'"/>: <span t-field="company.vat"/>
                            </div>
                        </div>
                    </div>
                    <div style="border-bottom: 1px solid #ccc; margin-top: 4px;"/>
                </div>
                <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" t-att-data-oe-lang="o.env.context.get('lang')">
                    <div class="page">

                        <!-- Encabezado -->
                        <div class="row mb-1">
                            <div class="col-9">
                                <!-- margin-top en 0: el h2 trae margen propio del tema y
                                     sumaba espacio en blanco bajo el encabezado. -->
                                <h2 style="margin-top:0; margin-bottom:4px;">
                                    Hoja de Ruta — <span t-field="o.name"/>
                                </h2>
                                <t t-set="visit_pickings" t-value="o._route_optimizer_pickings_visit_order().filtered(lambda p: p.state != 'cancel')"/>
                                <t t-set="total_weight" t-value="sum(p.shipping_weight or 0 for p in visit_pickings)"/>
                                <span style="font-size:12px;">
                                    <t t-if="o.user_id">
                                        <strong>Responsable:</strong>
                                        <span t-field="o.user_id"/>
                                        &amp;nbsp;·&amp;nbsp;
                                    </t>
                                    <t t-if="o.scheduled_date">
                                        <strong>Fecha:</strong>
                                        <span t-field="o.scheduled_date"/>
                                        &amp;nbsp;·&amp;nbsp;
                                    </t>
                                    <strong>Paradas:</strong>
                                    <span t-esc="len(visit_pickings)"/>
                                    <t t-if="total_weight">
                                        &amp;nbsp;·&amp;nbsp;
                                        <strong>Peso total:</strong>
                                        <span t-esc="'%.1f kg' % total_weight"/>
                                    </t>
                                </span>
                            </div>
                            <!-- QR code Google Maps (solo si hay ruta optimizada) -->
                            <div class="col-3 text-right" t-if="o.route_optimizer_gmaps_qr_src">
                                <img t-att-src="o.route_optimizer_gmaps_qr_src"
                                     style="width:90px; height:90px;"
                                     title="Abrir ruta en Google Maps"/>
                                <div style="font-size:8px; color:#555; margin-top:2px;">Ruta Google Maps</div>
                            </div>
                        </div>

                        <!-- Tabla de paradas — border-collapse para bordes limpios en wkhtmltopdf -->
                        <table style="width:100%; border-collapse:collapse; font-size:11px; margin-top:6px;">
                            <thead>
                                <tr style="background-color:#f0f0f0;">
                                    <th style="width:4%;  border:1px solid #bbb; padding:4px 3px;">#</th>
                                    <th style="width:18%; border:1px solid #bbb; padding:4px 3px;">Cliente</th>
                                    <th style="width:9%;  border:1px solid #bbb; padding:4px 3px;">Teléfono</th>
                                    <th style="width:25%; border:1px solid #bbb; padding:4px 3px;">Dirección</th>
                                    <th style="width:29%; border:1px solid #bbb; padding:4px 3px;">Productos</th>
                                    <th style="width:9%;  border:1px solid #bbb; padding:4px 3px;">Ventana</th>
                                    <th style="width:6%;  border:1px solid #bbb; padding:4px 3px;">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="visit_pickings" t-as="pick">
                                    <tr>
                                        <td style="border:1px solid #ddd; padding:4px 3px; font-weight:bold; color:#1565C0; vertical-align:top;">
                                            <!-- Posición en la ruta, no el valor crudo de
                                                 batch_sequence: al reordenar a mano varias
                                                 filas quedan en 0 y se imprimían "0 0 0 3". -->
                                            <span t-esc="pick_index + 1"/>
                                        </td>
                                        <td style="border:1px solid #ddd; padding:4px 3px; vertical-align:top;">
                                            <span t-field="pick.partner_id"/>
                                        </td>
                                        <td style="border:1px solid #ddd; padding:4px 3px; white-space:nowrap; vertical-align:top;">
                                            <span t-esc="pick.route_optimizer_partner_phone"/>
                                        </td>
                                        <td style="border:1px solid #ddd; padding:4px 3px; vertical-align:top;">
                                            <span t-esc="pick.route_optimizer_delivery_address"/>
                                        </td>
                                        <td style="border:1px solid #ddd; padding:4px 3px; font-size:10px; vertical-align:top;">
                                            <span t-esc="pick.route_optimizer_products_summary"/>
                                        </td>
                                        <td style="border:1px solid #ddd; padding:4px 3px; white-space:nowrap; font-size:10px; vertical-align:top;">
                                            <span t-esc="pick.route_optimizer_time_window"/>
                                        </td>
                                        <td style="border:1px solid #ddd; padding:4px 3px; vertical-align:top;">
                                            <span t-field="pick.state"/>
                                        </td>
                                    </tr>
                                    <!-- Fila de notas (solo si existe) -->
                                    <tr t-if="pick.note">
                                        <td style="border:1px solid #ddd; padding:2px 3px;"/>
                                        <td colspan="6" style="border:1px solid #ddd; padding:2px 6px; font-size:10px; color:#555;">
                                            <i><span t-field="pick.note" t-options='{"widget": "text"}'/></i>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="2" style="border-top:2px solid #555; padding:4px 3px; font-weight:bold;">
                                        Total: <span t-esc="len(visit_pickings)"/> paradas
                                    </td>
                                    <td colspan="2" style="border-top:2px solid #555; padding:4px 3px;"/>
                                    <td colspan="3" style="border-top:2px solid #555; padding:4px 3px; font-weight:bold;" t-if="total_weight">
                                        Peso: <span t-esc="'%.1f kg' % total_weight"/>
                                    </td>
                                    <td colspan="3" style="border-top:2px solid #555; padding:4px 3px;" t-if="not total_weight"/>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Bloque de firma — espacio amplio para escribir -->
                        <div class="row" style="margin-top:50px;">
                            <div class="col-5">
                                <div style="font-size:10px; color:#555; margin-bottom:60px;">Firma del transportista</div>
                                <div style="border-top:1px solid #333; padding-top:4px; font-size:10px;">Aclaración</div>
                            </div>
                            <div class="col-2"/>
                            <div class="col-5">
                                <div style="font-size:10px; color:#555; margin-bottom:60px;">Fecha / Hora de entrega</div>
                                <div style="border-top:1px solid #333; padding-top:4px; font-size:10px;">Sello / Recibido conforme</div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="footer" style="font-size: 8px; color: #777; border-top: 1px solid #ccc; padding-top: 3px;">
                    <div class="row">
                        <div class="col-6"><span t-field="company.name"/></div>
                        <div class="col-6 text-end">Página <span class="page"/> / <span class="topage"/></div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
