<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_delivery_zone" model="ir.ui.view">
        <field name="name">stock.picking.form.delivery_zone</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="scheduled_date" position="after">
                <field name="delivery_zone_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="vpicktree_delivery_zone" model="ir.ui.view">
        <field name="name">stock.picking.list.delivery_zone</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="delivery_zone_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_picking_internal_search_delivery_zone" model="ir.ui.view">
        <field name="name">stock.picking.search.delivery_zone</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="delivery_zone_id"/>
            </field>
            <group position="inside">
                <filter
                    name="group_delivery_zone"
                    string="Zona de entrega"
                    context="{'group_by': 'delivery_zone_id'}"
                />
            </group>
        </field>
    </record>

</odoo>
