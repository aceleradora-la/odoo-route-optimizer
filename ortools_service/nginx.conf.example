# Reverse proxy nginx para el microservicio OR-Tools detrás de un subdominio HTTPS.
# Copiar a /etc/nginx/sites-available/ors.aceleradora.la y ajustar el server_name.
# El certificado lo agrega certbot (--nginx) automáticamente sobre este bloque.

server {
    server_name ors.aceleradora.la;
    listen 80;

    # Los payloads VRP son chicos; 10 MB es holgado.
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # El solver puede tardar con muchos nodos; margen amplio.
        proxy_read_timeout 180s;
        proxy_connect_timeout 10s;
    }
}
